import struct

files = [
    ('EM43A Back To Stock.OsirisROM', 'Back To Stock'),
    ('EM43A.OsirisROM', 'Tuned / Custom')
]

for fname, label in files:
    with open(fname, 'rb') as f:
        data = f.read()
    print(f"================ {fname} ({label}) | Size: {len(data)} (0x{len(data):X}) ================")
    # Let's verify exact contiguous byte ranges from 0x000000 to len(data)
    # 0x000000..0x00001F (32 B): Magic banner
    # 0x000020..0x000022 (3 B): \r\n\x1a
    # 0x000023..0x00003F (29 B): Zero padding
    # 0x000040..0x000043 (4 B): fBH`
    # 0x000044..0x000047 (4 B): 00 01 00 00
    # 0x000048..0x00004B (4 B): 00 05 00 00 (B2S) vs 00 03 00 00 (Tune)
    # 0x00004C..0x00005F (20 B): Zero padding
    # 0x000060..0x000077 (24 B): ROMData header (8B tag + 12B u32s + 4B word)
    # 0x000078..0x100077 (1,048,576 B = 0x100000): ROMData payload
    # 0x100078..EOF: Trailer
    assert len(data) >= 0x100078
    assert data[0x00:0x20] == b'UpRev Osiris ROM File Ver 1.0000'
    assert data[0x20:0x23] == b'\r\n\x1a'
    assert data[0x23:0x40] == b'\x00' * (0x40 - 0x23)
    assert data[0x4C:0x60] == b'\x00' * (0x60 - 0x4C)
    print("Header & ROMData assertions passed.")
    pos = 0x100078
    while pos < len(data):
        if data[pos:pos+10] == b'AITuneDesc':
            tag = 'AITuneDesc'
            tlen = 10
        elif pos + 8 <= len(data) and all(32 <= b < 127 for b in data[pos:pos+8]):
            tag = data[pos:pos+8].decode('ascii')
            tlen = 8
        else:
            print(f"  0x{pos:06X}..0x{len(data):06X} ({len(data)-pos} B): Raw trailing/embedded bytes starting with {data[pos:pos+16].hex(' ')}")
            break
        u0, u1, u2 = struct.unpack('<III', data[pos+tlen:pos+tlen+12])
        w4 = data[pos+tlen+12:pos+tlen+16]
        end_rec = pos + u1
        print(f"  0x{pos:06X}..0x{end_rec:06X} ({u1} B): Tag={tag!r} (tlen={tlen}), u32=({u0}, {u1}, {u2}), w4={w4.hex(' ')}, payload_start=0x{pos+tlen+16:06X} (len={u0} B)")
        pos = end_rec


