import pandas as pd
import numpy as np
from io import StringIO

def load_log(fname):
    with open(fname, "r", encoding="utf-8", errors="replace") as f:
        raw = [l.rstrip("\r\n") for l in f]
    header = raw[0]
    rows = [l for i, l in enumerate(raw) if i > 0 and l != header]
    df = pd.read_csv(StringIO(header + "\n" + "\n".join(rows)))
    df.columns = [c.strip() for c in df.columns]
    ren = {
        "accel pedal(g/s)": "app",
        "engine coolant temperature (degrees Celsius )": "ect",
        "Engine RPM (rpm)": "rpm",
        "intake air temperature (degrees Celsius )": "iat",
        "mass airflow sensor(g/s)": "maf",
        "throttle position (unk)": "tps",
    }
    df = df.rename(columns=ren)
    for c in ["app", "ect", "rpm", "iat", "maf", "tps"]:
        df[c] = pd.to_numeric(df[c], errors="coerce")
    df["dt"] = pd.to_datetime(df["Device Time"], format="%d-%b-%Y %H:%M:%S.%f")
    return df

df1 = load_log("trackLog-2026-Nov-25_17-33-30.csv")
df2 = load_log("trackLog-2026-Nov-25_17-33-47.csv")

# Check sample intervals and duplicate timestamps
for name, d in [("Warmup (17-33-30)", df1), ("Blip/Decel (17-33-47)", df2)]:
    t0 = d["dt"].iloc[0]
    d["t"] = (d["dt"] - t0).dt.total_seconds()
    dt_diffs = d["dt"].diff().dt.total_seconds().dropna()
    print(f"=== {name} ===")
    print(f"Time: {d['dt'].iloc[0]} -> {d['dt'].iloc[-1]} (span={d['t'].iloc[-1]:.2f}s), dt min={dt_diffs.min():.3f}s, median={dt_diffs.median():.3f}s, max={dt_diffs.max():.3f}s")
    valid = d.dropna(subset=["rpm", "ect", "iat", "app", "tps", "maf"])
    print(f"Valid (non-'-') rows: {len(valid)} / {len(d)} (first valid t={valid['t'].iloc[0]:.2f}s, last valid t={valid['t'].iloc[-1]:.2f}s)")
    # Check RPM step sizes
    rpm_vals = np.sort(valid["rpm"].unique())
    rpm_steps = np.diff(rpm_vals)
    print(f"RPM unique count={len(rpm_vals)}, min={rpm_vals.min()}, max={rpm_vals.max()}, common diffs={pd.Series(np.round(rpm_steps, 4)).value_counts().head(5).to_dict()}")
    # Check TPS unique step sizes
    tps_vals = np.sort(valid["tps"].unique())
    tps_steps = np.diff(tps_vals)
    print(f"TPS unique count={len(tps_vals)}, min={tps_vals.min():.4f}, max={tps_vals.max():.4f}, common diffs={pd.Series(np.round(tps_steps, 6)).value_counts().head(5).to_dict()}")
    # Check APP unique step sizes
    app_vals = np.sort(valid["app"].unique())
    app_steps = np.diff(app_vals)
    print(f"APP unique count={len(app_vals)}, min={app_vals.min():.4f}, max={app_vals.max():.4f}, common diffs={pd.Series(np.round(app_steps, 6)).value_counts().head(5).to_dict()}")

# Detailed check of warm-up log (df1): ECT vs idle RPM
v1 = df1.dropna(subset=["rpm", "ect"]).copy()
print("\n=== Warmup log ECT vs RPM ===")
for ect_val, grp in v1.groupby("ect"):
    print(f"  ECT={ect_val:4.1f}°C: n={len(grp):3d}, t={grp['t'].iloc[0]:5.1f}..{grp['t'].iloc[-1]:5.1f}s, RPM min={grp['rpm'].min():6.1f}, med={grp['rpm'].median():6.1f}, max={grp['rpm'].max():6.1f}, TPS=[{grp['tps'].min():.2f}..{grp['tps'].max():.2f}%], MAF=[{grp['maf'].min():.2f}..{grp['maf'].max():.2f}]")

# Detailed check of blip/decel log (df2): peaks, decel fuel-cut / idle return, and end-of-log engine-off
v2 = df2.dropna(subset=["rpm", "ect"]).copy()
print("\n=== Blip/Decel log phases & peaks ===")
peaks = v2.nlargest(12, "rpm")[["t", "rpm", "ect", "iat", "app", "tps", "maf"]]
print("Top 12 RPM rows:")
print(peaks.round(2).to_string())

# Find zero-pedal decel windows where RPM > 1100 and app == 0
decel = v2[(v2["app"] == 0) & (v2["rpm"] >= 1100)]
print(f"\nZero-pedal (app==0) rows with RPM >= 1100: {len(decel)}")
if len(decel) > 0:
    print(decel[["t", "rpm", "ect", "app", "tps", "maf"]].head(25).round(2).to_string())

# Check when RPM drops to 0 at end of df2
zero_rpm = v2[v2["rpm"] == 0]
print(f"\nRPM == 0 rows: count={len(zero_rpm)}, t={zero_rpm['t'].min():.2f}s..{zero_rpm['t'].max():.2f}s")
idx_first_zero = zero_rpm.index[0]
print("Around first RPM == 0:")
print(v2.loc[max(0, idx_first_zero-6):min(len(v2)-1, idx_first_zero+4), ["t", "rpm", "ect", "app", "tps", "maf"]].round(2).to_string())


