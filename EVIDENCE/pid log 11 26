```python
import struct
import pandas as pd
import numpy as np
from io import StringIO
import matplotlib.pyplot as plt

def load_log(fname):
    with open(fname, "r", encoding="utf-8", errors="replace") as f:
        raw = [l.rstrip("\r\n") for l in f]
    header = raw[0]
    rows = [l for i, l in enumerate(raw) if i > 0 and l != header]
    df = pd.read_csv(StringIO(header + "\n" + "\n".join(rows)))
    df.columns = [c.strip() for c in df.columns]
    df = df.rename(columns={
        "accel pedal(g/s)": "app",
        "engine coolant temperature (degrees Celsius )": "ect",
        "Engine RPM (rpm)": "rpm",
        "intake air temperature (degrees Celsius )": "iat",
        "mass airflow sensor(g/s)": "maf",
        "throttle position (unk)": "tps",
    })
    for c in ["app", "ect", "rpm", "iat", "maf", "tps"]:
        df[c] = pd.to_numeric(df[c], errors="coerce")
    df["dt"] = pd.to_datetime(df["Device Time"], format="%d-%b-%Y %H:%M:%S.%f")
    df["t"] = (df["dt"] - df["dt"].iloc[0]).dt.total_seconds()
    return df

df1 = load_log("trackLog-2026-Nov-25_17-33-30.csv").dropna(subset=["rpm", "ect"])
df2 = load_log("trackLog-2026-Nov-25_17-33-47.csv").dropna(subset=["rpm", "ect"])

with open("f501.bin", "rb") as f:
    rom = f.read()
n = len(rom)

# 1. Analyze df1 warm-up curve breakpoints (ECT -> median RPM, TPS, MAF)
wu = df1.groupby("ect").agg(
    n=("rpm", "count"),
    rpm_med=("rpm", "median"),
    rpm_min=("rpm", "min"),
    rpm_max=("rpm", "max"),
    tps_med=("tps", "median"),
    maf_med=("maf", "median"),
).reset_index()
print("=== Log 1 Warmup Summary (ECT -> Median RPM/TPS/MAF) ===")
print(wu.to_string(index=False))

# Check hot idle at the end of Log 2 (when app==0 and steady low RPM, e.g., t=379..390s)
hot_idle = df2[(df2["app"] == 0) & (df2["ect"] >= 80) & (df2["rpm"] > 500) & (df2["rpm"] < 1000)]
print("\n=== Log 2 Hot Idle (ECT >= 80°C, APP == 0, 500 < RPM < 1000) ===")
print(f"Count={len(hot_idle)}, RPM min={hot_idle['rpm'].min()}, p25={np.percentile(hot_idle['rpm'],25)}, med={hot_idle['rpm'].median()}, p75={np.percentile(hot_idle['rpm'],75)}, max={hot_idle['rpm'].max()}")
print("Top hot idle RPMs:", hot_idle["rpm"].value_counts().head(8).to_dict())
print("Top hot idle TPS:", hot_idle["tps"].round(2).value_counts().head(6).to_dict())
print("Top hot idle MAF:", hot_idle["maf"].round(2).value_counts().head(6).to_dict())

# 2. Scan f501.bin for candidate tables/curves matching:
# (A) Warm-up target idle RPM curve: ~1437.5 @ 32°C -> ~1025 @ 41-50°C -> ~937.5 @ 56-57°C -> ~687.5-737.5 @ 84°C
# Notice: if raw uint16 is RPM directly (e.g. 1437 -> 1025 -> 937 -> 700), or uint8 * 12.5 (115 -> 82 -> 75 -> 56), or uint16 * 12.5!
print("\n=== Scanning f501.bin for Warmup Idle Target Curves (decreasing with temp) ===")
# Check uint16 BE decreasing/non-increasing arrays of len 6..16 where start in [1300..1650] and end in [600..850]
for off in range(0, n - 32, 2):
    vals = [struct.unpack(">H", rom[off + 2*k : off + 2*k + 2])[0] for k in range(16)]
    # Check lengths 6..16
    for L in range(6, 17):
        sub = vals[:L]
        if 1250 <= sub[0] <= 1700 and 600 <= sub[-1] <= 850:
            if all(sub[i] >= sub[i+1] and (sub[i] - sub[i+1]) <= 300 for i in range(L-1)):
                if len(set(sub)) >= 4 and all(v % 5 == 0 or v % 12 == 0 or v % 13 == 0 for v in sub):
                    print(f"  [u16BE 1x RPM] 0x{off:06X} (len={L:2d}): {sub}")
                    break

# Also check uint8 decreasing arrays of len 6..16 where u8 * 12.5 starts in [1250..1700] (raw 100..136) and ends in [600..850] (raw 48..68)
for off in range(0, n - 16):
    vals = list(rom[off:off+16])
    for L in range(6, 17):
        sub = vals[:L]
        if 100 <= sub[0] <= 136 and 48 <= sub[-1] <= 68:
            if all(sub[i] >= sub[i+1] and (sub[i] - sub[i+1]) <= 24 for i in range(L-1)):
                if len(set(sub)) >= 4:
                    rpm_s = [round(v * 12.5, 1) for v in sub]
                    print(f"  [u8 * 12.5 RPM] 0x{off:06X} (len={L:2d}): raw={sub} -> RPM={rpm_s}")
                    break

# 3. Scan f501.bin for RPM axes covering both 925..1462.5 RPM AND 3237.5 RPM (e.g. up to 3200..7000 RPM)
print("\n=== Scanning f501.bin for Broad RPM Axes (spanning <= 1000 to >= 3200 RPM) ===")
u16_inc = []
for off in range(0, n - 12, 2):
    vals = [struct.unpack(">H", rom[off:off+2])[0]]
    for k in range(1, 24):
        p = off + 2*k
        if p + 2 > n: break
        v = struct.unpack(">H", rom[p:p+2])[0]
        if v > vals[-1] and (v - vals[-1]) <= 2000:
            vals.append(v)
        else:
            break
    if len(vals) >= 6:
        u16_inc.append((off, vals))

# Deduplicate
u16_inc_dedup = []
for off, vals in u16_inc:
    end = off + 2*len(vals)
    if not any(f_o <= off and end <= f_o + 2*len(f_v) for f_o, f_v in u16_inc if f_o != off):
        u16_inc_dedup.append((off, vals))

for off, vals in u16_inc_dedup:
    for scale_name, mult in [("1x RPM", 1.0), ("12.5x RPM", 12.5), ("50x RPM", 50.0)]:
        sc = [v * mult for v in vals]
        if sc[0] <= 1000 and sc[-1] >= 3200 and sc[-1] <= 8000:
            if mult == 1.0 and all(v % 25 == 0 for v in vals):
                print(f"  0x{off:06X} (len={len(vals):2d}, {scale_name}): {vals}")
            elif mult > 1.0 and all(v % 4 == 0 or v % 5 == 0 or v % 8 == 0 for v in vals):
                print(f"  0x{off:06X} (len={len(vals):2d}, {scale_name}): raw={vals} -> RPM={[int(x) if x.is_integer() else x for x in sc]}")


