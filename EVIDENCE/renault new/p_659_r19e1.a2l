     /* worst case raster time [us]           */ 90000
     /* maximum read variables                */ 100
     /* maximum write variables               */ 0
    /end SOURCE


    /begin TP_BLOB
       /* version                */ 0x1000103
       /* interface speed        */ INTERFACE_SPEED_100MBIT
       /* reset_cfg - only MPC   */ 0x7FFFFF07 /* not used for TriCore */

       DISTAB_CFG
         /* Distab Type          */ 13
         /* Distab Data type     */ 0x122
         /* ByteOrder 1=LSB last */ 0x2

         /* Trigger Segment Adr  */ 0x0
         /* Trigger Configuration*/ 0x01010100
                  TRG_MOD /*Id:*/ 0x0   /*trg_mod:*/0xFF 0x0 0x0 0x0


         ETK_CFG  0x10 0x13 0x61 0x01 0x00 0xFF 0xFF 0x63 0x88 0x64 0x0B 0x65 0x8C 0x66 0xA0 0x67 0x91 0x68 0x9E

         RESERVED_DISTAB_MEMORY
           /* start_addr  */ 0x80040078
           /* length      */ 0x0
           /* location    */ EXTERN
           /* application */ MEASUREMENT
           /* usage       */ CHECKSUM_EXCLUDE_ONLY
           /* mirrors     */ 0xFFFFFFFF 0xFFFFFFFF 0xFFFFFFFF 0xFFFFFFFF 0xFFFFFFFF

    /begin COLDSTART_HANDSHAKE
      /* Address of ETKS coldstart pattern */    0x8FF20098

      WAIT
        /* Dyn. length for wait pattern    */    0xE5 0xAD 0xEC 0x4D

      READY
        /* Dyn. length for ready pattern    */   0xDE 0xC0 0xED 0xFE

    /end COLDSTART_HANDSHAKE

      CAL_WAKEUP
        /* 1 = wake up enabled, 0=disabled */ CAL_WAKEUP_PIN 1
        CAL_TOOL_PRESENT
          /* address for the pattern       */ 0x8FF2008C
          /* CAL_TOOL_PRESENT_PATTERN      */ 0x12345678
          /* ECU timeout for shutdown in s */ 2

        PAGE_SWITCH_METHOD
        1                      /* version                              */
        MAILBOX
            1           /* MBX_Version                                 */
                        /* Version of mailbox                          */
            200          /* MBX_PageSetupTime                           */
                        /* max time the ECU needs to set up page in ms */
            0x8FF200A0  /* MBX_StartAddress                            */
                        /* Start address of table                      */

        AUTOSTART_BEHAVIOR    LAST_ACTIVE_PAGE  /* Table to be filled by INCA with info */
                                                /* for the current active page          */

        OCT_WORKINGPAGE
            0x400     /* OCT_Type         Type of table                  */
            0x8FF200A8  /* OCT_StartAddress Start address of table         */
            0xDC   /* OCT_Length       max Length of table in byte    */

    /end TP_BLOB
  /end IF_DATA

   /begin IF_DATA ASAP1B_KWP2000
      /begin SOURCE
         /* Name        */ "10ms time synchronous"
         /* CSE-units   */ 4
         /* min periode */ 1
         QP_BLOB
            /* Physical layer          */ KLINE_AND_CAN
            /* Measurement mode        */ BLOCKMODE
            /* Block mode local ID     */ 0xF0
            /* max. no of signals      */ 20
            /* max. no of bytes        */ 40
            /* CAN-ID for EUDTP        */ 0x0 /* don't care if not CAN */
            /* Raster ID for EUDTP     */ 0          /* and FREERUNNINGMODE   */
      /end SOURCE

      /begin TP_BLOB
         /* Blob version               */ 0x200
         /* KWP Version                */ VDA_1996
         /* byte order                 */ MSB_LAST
         K_LINE
            /* ECU stimulation mode    */ WuP
            /* ECU address on k line   */ 0x11
            /* requ. tester address    */ 0xF1
         /begin CAN
            /* Baudrate [Hz]           */ 1000000
            /* Sample point            */ 60
            /* samples per bit         */ 1
            /* BTL_CYCLES              */ 19
            /* SJW                     */ 3
            /* SYNC_EDGEGE             */ 0
            /begin ADDRESS
               /* CAN_ID ECU           */ 0x611
               /* CAN_ID INCA          */ 0x6F0
               /* Extended address ECU */ /* TGT_ECU  0x10 not used with normal addressing */
               /* Extended address INCA*/ /* TGT_INCA 0xF1 not used with normal addressing */
            /end ADDRESS
            NETWORK_LIMITS
               /* WFT_MAX              */ 10
               /* XDL_MAX              */ 0xFFF
         /end CAN

         DATA_ACCESS
            /* Flash address */ 0x0
            /* RAM address   */ 0x0
            /* Data Read     */ 1
            /* Code Verify   */ 0
            /* Code Read     */ 0
            /* Load mode     */ 1

         /begin CHECKSUM
            /* Checksum Type           */ 0x10201
            /* only at active Page     */ 1
            /* loc Routine Id Checksum */ 1
            /* result delivered by     */ RequestRoutineResults
            RNC_RESULT 0x23
         /end CHECKSUM

         /begin COPY
            /* mode copy Flash to RAM  */ RAM_InitByECU
            /* DiagModeCopyFlashToRam  */ 0xFA
         /end COPY

         /begin FLASH
            /* mode copy RAM to Flash  */ NOFLASHBACK
            /* loc Routine Id flashing */ 3
            /* result delivered by     */ RequestRoutineResults
            COPY_FRAME 1
            RNC_RESULT 0x23 0xFB 0xFC
         /end FLASH

         /begin DIAG_BAUD
            /* BaudRate */ 10400
            /* DiagMode */ 0xFA
            BD_PARA 0x14
         /end DIAG_BAUD

         /begin DIAG_BAUD
            /* BaudRate */ 41600
            /* DiagMode */ 0xFA
            BD_PARA 0x54
         /end DIAG_BAUD

         /begin DIAG_BAUD
            /* BaudRate */ 62400
            /* DiagMode */ 0xFA
            BD_PARA 0x67
         /end DIAG_BAUD

         /begin DIAG_BAUD
            /* BaudRate */ 83200
            /* DiagMode */ 0xFA
            BD_PARA 0x74
         /end DIAG_BAUD

         /begin DIAG_BAUD
            /* BaudRate */ 125000
            /* DiagMode */ 0xFA
            BD_PARA 0x87
         /end DIAG_BAUD

         /begin TIME_DEF
            /* Timing Parameter: p1Max  p2Min  p2Max  p3Min  p3Max  p4Min  in ms */
            KWP_TIMING 20  0  50  3  512  0
            KWP_TIMING 20  25  50  55  5000  5
            KWP_TIMING 20  0  2000  0  5000  65440

            /* Timing Parameter: As     Bs     Cr  in ms                         */
        USDTP_TIMING 8192  256  256
        USDTP_TIMING 4096  256  256
         /end TIME_DEF

         /* Seed&Key Parameter: AccMode  CalcMethod  Delay */
         /* SECURITY_ACCESS        9          1        0   */

         /begin PAGE_SWITCH
            /* mode for page switch */ ESCAPE_CODE
            ESCAPE_CODE_PARA_SET 0x90
            ESCAPE_CODE_PARA_GET 0x91
            PAGE_CODE 0x0 0x1
         /end PAGE_SWITCH

      /end TP_BLOB
   /end IF_DATA

/begin CHARACTERISTIC

