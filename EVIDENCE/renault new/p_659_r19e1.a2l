        CAN_ID_FIXED        0x350
        FIRST_PID           25
        RASTER              2
      /end QP_BLOB
    /end SOURCE
    
    /begin RASTER
      /* event name       */ "segment synchronous"
      /* event short name */ "seg_sync"
