import numpy as np

def scan_calibration_blocks(filename, block_size=256, stride=16):
    """
    Scans a binary file for 16x16 UBYTE calibration blocks using:
    1. Monotonic Boundary Check
    2. Gradient Continuity Test
    3. Paired Offset / Stride Tagging
    """
    with open(filename, "rb") as f:
        data = f.read()
    
    candidates = []
    
    # Slide through the binary data with the specified stride
    for i in range(0, len(data) - block_size, stride):
        block = data[i:i + block_size]
        matrix = np.frombuffer(block, dtype=np.uint8).reshape(16, 16)
        
        # Filter 1: Monotonic Boundary Check
        # Exclude zero blocks and ensure non-zero entries fall within [60, 200]
        non_zeros = matrix[matrix > 0]
        if len(non_zeros) < 128:  # Skip sparse/padding blocks
            continue
        if not (np.all(non_zeros >= 60) and np.all(non_zeros <= 200)):
            continue
            
        # Filter 2: Gradient Continuity Test
        # Test for ignition-style negative slope along the load axis (columns) 
        # or AFR-style localized enrichment clusters.
        col_means = np.mean(matrix, axis=0)
        is_monotonic_decreasing = np.all(np.diff(col_means) <= 0)
        
        # Check variance to filter out constant midpoint fills (e.g., 0x80 flats)
        if np.var(matrix) < 5.0:
            continue
            
        candidates.append({
            'address': hex(i),
            'monotonic_load': bool(is_monotonic_decreasing),
            'variance': float(np.var(matrix)),
            'mean': float(np.mean(matrix))
        })
        
    return candidates

